# The CSSB cluster's settings for StructCooker / DataCooker. `source scripts/cluster/cssb.env`
# before building (jobs inherit the submitting shell's environment). Another cluster: copy this
# file and change the values; nothing in the code names a partition, a node or a site path
# except as these variables' defaults.

# Where everything lives (raw, reference, intermediate, lmdb, metadata, docs).
export BIOMOL_ROOT=/data/shared/cssb_data/BioMol_clean
# Shared sequence search databases (UniRef30, MMseqs2); only teddymer/msa_search uses them.
export SEQ_DB_ROOT=/data/shared/cssb_data/seq_db

# SLURM: the uncapped CPU partition/QOS, and nodes to keep jobs off (their /dev/shm cannot hold
# joblib's semaphores, so a parallel task would refuse to start there).
export DATACOOKER_PARTITION=cpu-long
export DATACOOKER_QOS=cpu-long-q
export DATACOOKER_EXCLUDE_NODES=node01,node04,node07
# A full node, as one job asks for it (DataCooker's planner and StructCooker's full-node jobs).
export DATACOOKER_CPUS_PER_NODE=112
export DATACOOKER_NODE_MEM_GB=490
